{
    "name": "batchencodingconverter",
    "displayName": "BatchEncodingConverter",
    "description": "Batch convert file encodings in a workspace: Shift_JIS, EUC-JP, ISO-2022-JP, UTF-8 (with or without BOM) and UTF-16, in any direction.",
    "version": "1.3.1",
    "publisher": "yuna611d",
    "license": "MIT",
    "icon": "images/icon.png",
    "engines": {
        "vscode": "^1.33.0"
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "encoding",
        "Shift_JIS",
        "EUC-JP",
        "ISO-2022-JP",
        "文字コード"
    ],
    "galleryBanner": {
        "color": "#1E3A5F",
        "theme": "dark"
    },
    "activationEvents": [
        "onCommand:extension.convertEncoding"
    ],
    "main": "./out/extension",
    "extensionKind": [
        "workspace"
    ],
    "capabilities": {
        "virtualWorkspaces": {
            "supported": false,
            "description": "Files are read and written through the file system, which a virtual workspace does not provide."
        },
        "untrustedWorkspaces": {
            "supported": true,
            "description": "Nothing from the workspace is executed; files are only read, converted and written on an explicit command."
        }
    },
    "contributes": {
        "commands": [
            {
                "command": "extension.convertEncoding",
                "title": "BatchEncodingConvert: Convert Files Encoding"
            }
        ],
        "configuration": {
            "title": "BatchEncodingConverter",
            "properties": {
                "batchEncodingConverter.excludeDirectories": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "node_modules"
                    ],
                    "description": "Directory names skipped when converting sub directories. Hidden directories (names starting with a dot) and the extension’s own _<encoding> output directories are always skipped, whatever this is set to."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "lint": "eslint src",
        "test:unit": "npm run compile && mocha",
        "test:integration": "npm run compile && node ./out/test/runTest.js",
        "test": "npm run lint && npm run test:unit"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/encoding-japanese": "^2.2.1",
        "@types/mocha": "^10.0.10",
        "@types/node": "^18.19.130",
        "@types/vscode": "~1.33.0",
        "@vscode/test-electron": "^2.5.2",
        "eslint": "^9.39.5",
        "mocha": "^12.0.3",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.67.0"
    },
    "dependencies": {
        "encoding-japanese": "^2.2.0",
        "iconv-lite": "^0.4.24"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/yuna611d/BatchEncodingConverter.git"
    },
    "bugs": {
        "url": "https://github.com/yuna611d/BatchEncodingConverter/issues"
    },
    "homepage": "https://github.com/yuna611d/BatchEncodingConverter#readme"
}
