{
    "name": "batchencodingconverter",
    "displayName": "BatchEncodingConverter",
    "description": "convert encoding of files in current workspace.",
    "version": "1.0.3",
    "publisher": "yuna611d",
    "engines": {
        "vscode": "^1.33.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onCommand:extension.convertSjisToUTF8",
        "onCommand:extension.convertUTF8ToSjis"
    ],
    "main": "./out/extension",
    "contributes": {
        "commands": [
            {
                "command": "extension.convertSjisToUTF8",
                "title": "BatchEncodingConvert: SJIS to UTF8"
            },
            {
                "command": "extension.convertUTF8ToSjis",
                "title": "BatchEncodingConvert: UTF8 to SJIS"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "lint": "eslint src",
        "test:unit": "npm run compile && mocha",
        "test:integration": "npm run compile && node ./out/test/runTest.js",
        "test": "npm run lint && npm run test:unit"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/mocha": "^10.0.10",
        "@types/node": "^18.19.130",
        "@types/vscode": "~1.33.0",
        "@vscode/test-electron": "^2.5.2",
        "eslint": "^9.39.5",
        "mocha": "^11.8.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.67.0"
    },
    "dependencies": {
        "iconv-lite": "^0.4.24"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/yuna611d/BatchEncodingConverter.git"
    }
}
